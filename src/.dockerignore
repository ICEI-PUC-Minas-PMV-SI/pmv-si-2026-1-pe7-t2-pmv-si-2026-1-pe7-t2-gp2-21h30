# Ignorar controle de versão
.git
.github
.gitignore

# Ignorar caches do Python e do SO
__pycache__/
*.pyc
*.pyo
*.pyd
.DS_Store
Thumbs.db

# Ignorar ambientes virtuais locais
.env
.venv
env/
venv/
pip-log.txt
